# BELArcade - opciones adicionales del kernel

# Video: DRM/VC4 y consola en framebuffer
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_VC4_HDMI_CEC=y
CONFIG_DRM_V3D=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y
# Control: DualSense, joystick y teclado virtual del bridge
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID_PLAYSTATION=y
# Memorias USB (FAT32 y exFAT)
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
